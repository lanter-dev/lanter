{
  "name": "@lanter/lanter",
  "version": "0.1.0",
  "description": "CLI tool that uses agentic AI to convert codebases between programming languages",
  "type": "module",
  "bin": {
    "lanter": "./bin/lanter.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/emitter.test.js test/history.test.js test/display.test.js test/task.test.js test/eval-summary.test.js test/summary.test.js test/list-dir.test.js test/file-info.test.js test/count-lines.test.js test/project-info.test.js test/glob.test.js test/truncate.test.js test/context-trimmer.test.js"
  },
  "keywords": [
    "cli",
    "ai",
    "code-conversion",
    "transpiler",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lanter-dev/lanter.git"
  },
  "homepage": "https://github.com/lanter-dev/lanter",
  "bugs": {
    "url": "https://github.com/lanter-dev/lanter/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@clack/prompts": "^1.0.1",
    "@openai/agents": "^0.4.11",
    "@openai/agents-extensions": "^0.3.7",
    "chalk": "^5.0.0",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.0",
    "fast-glob": "^3.3.0",
    "openai": "^6.22.0",
    "ora": "^9.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "semantic-release": "^24.2.9"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  }
}
